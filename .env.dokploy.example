# =============================================================================
# Chatwoot no Dokploy — variáveis de ambiente
# Cole em: Dokploy > (sua aplicação) > Environment  e ajuste os valores.
#
# Gere um SECRET_KEY_BASE com:   openssl rand -hex 64
# =============================================================================

# --- Obrigatórias ---
FRONTEND_HOST=chat.exemplo.com            # apenas o host (sem https://)
SECRET_KEY_BASE=troque_por_um_hex_de_128_caracteres
POSTGRES_PASSWORD=troque_por_uma_senha_forte
REDIS_PASSWORD=troque_por_uma_senha_forte

# --- Versão da imagem (opcional) ---
CHATWOOT_TAG=v4.16.0

# --- App (opcional — sobrescreve os defaults do compose) ---
DEFAULT_LOCALE=pt_BR
FORCE_SSL=true                            # se der loop de redirect, use false
ENABLE_ACCOUNT_SIGNUP=false               # true | false | api_only
RAILS_MAX_THREADS=5

# --- Postgres (opcional) ---
POSTGRES_USERNAME=postgres
POSTGRES_DATABASE=chatwoot_production

# --- SMTP (opcional — habilita e-mail de saída) ---
MAILER_SENDER_EMAIL=Chatwoot <no-reply@exemplo.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
