# =============================================================================
# Chatwoot no Dokploy — variáveis de ambiente
# Cole em: Dokploy > (sua aplicação) > Environment  e ajuste os valores.
#
# Gere um SECRET_KEY_BASE com:   openssl rand -hex 64
# =============================================================================

# --- Obrigatórias ---
FRONTEND_HOST=chat.exemplo.com            # apenas o host (sem https://)

# Gere UMA vez e nunca mais troque: mudar isto desloga todo mundo.
SECRET_KEY_BASE=troque_por_um_hex_de_128_caracteres

# Use só letras e números (openssl rand -hex 24). Evite base64: o `/` e o `+`
# que ele gera já quebraram URLs de conexão neste tipo de setup, e um `$`
# é comido pela interpolação do Compose — o banco sobe com uma senha e a
# aplicação tenta outra.
POSTGRES_PASSWORD=troque_por_uma_senha_forte
REDIS_PASSWORD=troque_por_uma_senha_forte

# --- Criptografia em repouso (defina ANTES do primeiro login) ---
# Gere com: bundle exec rails db:encryption:init
# ou três vezes: openssl rand -hex 16
# Sem elas, tokens de canal ficam em texto puro no banco e o 2FA quebra.
# Depois que existir dado criptografado, trocá-las torna esse dado ilegível.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# --- Tag da imagem local (opcional) ---
# Esta build sai deste repositório, não da imagem oficial. A tag é só um
# rótulo local; troque para versionar seus deploys (ex.: 2026-08-12).
CHATWOOT_TAG=local

# --- Build (opcional) ---
# Heap máximo do Node durante o build do frontend, em MB.
# Use ~75% de (RAM + swap) do servidor, não um número maior "por garantia":
# acima do que a máquina tem, o V8 para de coletar lixo cedo e quem mata o
# processo é o OOM killer do kernel — exit 137, "Killed", sem stack. Num VPS
# de 4 GB, 3072 funciona melhor que 8192. Abaixo de ~3000 o build não passa.
NODE_HEAP_MB=8192

# --- App (opcional — sobrescreve os defaults do compose) ---
DEFAULT_LOCALE=pt_BR
FORCE_SSL=true                            # se der loop de redirect, use false
ENABLE_ACCOUNT_SIGNUP=false               # true | false | api_only
RAILS_MAX_THREADS=5

# --- Postgres (opcional) ---
POSTGRES_USERNAME=postgres
POSTGRES_DATABASE=chatwoot_production

# --- SMTP (opcional — habilita e-mail de saída) ---
MAILER_SENDER_EMAIL=Chatwoot <no-reply@exemplo.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
